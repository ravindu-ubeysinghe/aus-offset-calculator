{
  "name": "offset-calculator",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Mortgage offset interest calculator — web, iOS and Android.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
